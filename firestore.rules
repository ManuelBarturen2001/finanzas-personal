rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // El documento de usuario solo puede leerlo/crearlo/actualizarlo el propio
    // usuario (su uid es el ID del documento). No se permite borrar la
    // cuenta desde el cliente.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isOwner(userId) && request.resource.data.uid == userId;
      allow delete: if false;
    }

    // Regla genérica reutilizada por todas las colecciones financieras:
    // cada documento debe tener userId == uid del dueño, tanto para leer
    // como para escribir, y ese campo no puede cambiar en un update.
    match /accounts/{docId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId;
    }

    match /transactions/{docId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId;
    }

    match /recurringExpenses/{docId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId;
    }

    match /debts/{docId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId;
    }

    match /categories/{docId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId;
      // No se permite borrado físico de categorías desde el cliente:
      // el módulo de categorías hace soft-delete (isActive = false) para
      // no romper movimientos históricos que las referencian.
      allow delete: if false;
    }

    match /budgets/{docId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId;
    }

    // Un solo documento por usuario, con el propio uid como ID del
    // documento (ver salaryConfigService.ts), por eso aquí basta con
    // comparar el ID del doc en vez de leer resource.data.userId.
    match /salaryConfig/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Cualquier otra colección no listada explícitamente queda bloqueada
    // por defecto (deny-by-default).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
